# Environment Variables Template
# Copy this file to .env and fill in your values

# ===========================================
# SANITY CMS CONFIGURATION (required)
# ===========================================
# Get these from: https://sanity.io/manage

# Sanity project ID
VITE_SANITY_PROJECT_ID=your-sanity-project-id

# Sanity dataset name (usually "production")
VITE_SANITY_DATASET=production

# ===========================================
# NEWSLETTER — MAILCHIMP (optional, server-side)
# ===========================================
# Used by the /api/subscribe Vercel function.

# MAILCHIMP_API_KEY=your-mailchimp-api-key
# MAILCHIMP_LIST_ID=your-list-id
# MAILCHIMP_SERVER_PREFIX=us21

# ===========================================
# OBSERVABILITY (optional)
# ===========================================

# Sentry DSN (error monitoring, production only)
# VITE_SENTRY_DSN=your-sentry-dsn

# ===========================================
# SUPABASE (dormant — reserved for future community features)
# ===========================================
# Not required to run the site. Leave unset unless re-enabling the backend.

# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
