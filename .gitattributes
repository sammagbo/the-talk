# Store every text file with LF in the repository and check it out with LF,
# so a tool that rewrites a file cannot silently flip its line endings.
* text=auto eol=lf

# Binary assets: never inspected for line endings, never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mp3 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
